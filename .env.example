DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm

# Leave DRY_RUN=true to run locally with NO Telnyx account: nothing is sent,
# messages are logged as if delivered. Set false once you have a real number.
DRY_RUN=true

# --- Telnyx ---
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=...                 # account public key (base64), for webhook verify
TELNYX_MESSAGING_PROFILE_ID=...
TELNYX_FROM_NUMBER=+18135550100

# --- Cheap LLM (OpenAI-compatible; DeepSeek shown, swap base_url for others) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-v4-flash

# --- Booking ---
BOOKING_PROVIDER=static               # calendly | static
CALENDLY_TOKEN=...
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/XXXX
CALENDLY_SIGNING_KEY=...
STATIC_BOOKING_URL=https://calendly.com/you/intro

# --- Behavior ---
QUIET_HOURS_START=21                  # local hour; no sends at/after
QUIET_HOURS_END=9                     # local hour; no sends before
AUTO_SEND=false                       # false = agent drafts, holds for approval

# --- Throughput (keep at/under your 10DLC campaign MPS limit) ---
WORKER_INTERVAL_SECONDS=30
SEND_RATE_PER_MINUTE=60
